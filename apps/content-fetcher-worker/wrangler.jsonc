{
  "name": "content-fetcher-worker",
  "main": "src/index.js",
  "compatibility_date": "2024-01-01", // Keep this date, or update to a more recent one if wrangler suggests
  "compatibility_flags": [ // <--- NEW: Add this section
    "nodejs_compat"
  ],

  "queues": {
    "consumers": [
      {
        "queue": "article-content-fetch-queue"
        // "dead_letter_queue": "content-fetch-dlq" // Keep commented or create if needed
      }
    ],
    "producers": [
      {
        "binding": "ARTICLE_GEMINI_PROCESS_QUEUE",
        "queue": "article-gemini-process-queue"
      }
    ]
  }
  // <<<< REMOVED: The entire "secrets" array from here
  // Secrets are managed in the Cloudflare Dashboard for these specific bindings.
  // We just declare the environment variables in the code's Env interface.

  
}
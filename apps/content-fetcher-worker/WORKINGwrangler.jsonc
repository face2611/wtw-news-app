// C:\Users\phili\meridian\apps\content-fetcher-worker\wrangler.jsonc
{
  "name": "content-fetcher-worker",
  "main": "dist/index.js", // <<<< IMPORTANT: Now points to the Webpack output
  "compatibility_date": "2024-01-01", // Or your recent date
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": { // <<<< MODIFIED: This tells wrangler to use your webpack setup
    "command": "webpack --config webpack.config.js --mode=production", // Explicitly run webpack with your config
    "watch": "webpack --config webpack.config.js --mode=development --watch", // For local dev
    "upload": {
      "format": "modules", // <<<< IMPORTANT: Changed to 'modules' for ES module output from Webpack 5
      "main": "dist/index.js"
    }
  },
  // "webpack_config": "webpack.config.js", // This field is often for a legacy bundler. Newer wrangler uses `build.command`
                                        // The build.command handles calling webpack, so we likely don't need this.
                                        // Let's rely on `build.command` for now.

  "queues": { /* ... */ },
  "secrets": [ /* ... */ ]
}